PAR param;
VAR distance, root, column, shelf, wcs0Prt1, wcs1Prt1, wcsPrt2, wcsPrt2l, wcsPrt2ld, wcsPrt2d,
    instances, foc, fc, fc1, fc2, fc3, height, nShelves, i, z, shelfInstances, cwd, shelfScr, columnScr;

IF ISVOID(param) THEN param = {}; ENDIF
IF !ISVOID(param.height) THEN height = param.height; ELSE height = 2000; ENDIF
IF !ISVOID(param.nShelves) THEN nShelves = param.nShelves; ELSE nShelves = 3; ENDIF
IF !ISVOID(param.cwd) THEN cwd = param.cwd; ELSE cwd = "./"; ENDIF
shelfScr = cwd + "../shelf/shelf.ccscript";
columnScr = cwd + "../column/column.ccscript";

@api.v1.common.clear();
root = @api.v1.assembly.create();
root = root.result;
column = @api.v1.assembly.partTemplate();
column = column.result;
shelf = @api.v1.assembly.partTemplate();
shelf = shelf.result;

@api.v1.script.run({ file: columnScr, part: column, height: height, length: 60, depth: 5 });
@api.v1.script.run({ file: shelfScr, part: shelf, length: 750, depth: 500, ft: 10 });

instances = @api.v1.assembly.instance([
  { productId: column, ownerId: root },
  { productId: column, ownerId: root },
  { productId: column, ownerId: root },
  { productId: column, ownerId: root }
]);
instances = instances.result;

z = 40;
distance = (height -2*z)/(nShelves-1);
shelfInstances = [];
FOR i = 0 TO nShelves -1 DO
  shelfInstances = shelfInstances + [{ productId: shelf, ownerId: root, transformation: [{0,0,z},{1,0,0}, {0,1,0}], name: "Shelf" + i }];
  z = z + distance;
NEXT
shelfInstances = @api.v1.assembly.instance(shelfInstances);
shelfInstances = shelfInstances.result;

wcs0Prt1 = @api.v1.part.getWorkGeometry({id: column, name: "WCS0"} );
wcs0Prt1 = wcs0Prt1.result;
wcs1Prt1 = @api.v1.part.getWorkGeometry({id: column, name: "WCS1"} );
wcs1Prt1 = wcs1Prt1.result;

wcsPrt2 = @api.v1.part.getWorkGeometry({id: shelf, name: "WCS1"} );
wcsPrt2 = wcsPrt2.result;
wcsPrt2l = @api.v1.part.getWorkGeometry({id: shelf, name: "WCSL"} );
wcsPrt2l = wcsPrt2l.result;
wcsPrt2ld  = @api.v1.part.getWorkGeometry({id: shelf, name: "WCSLD"} );
wcsPrt2ld = wcsPrt2ld.result;
wcsPrt2d  = @api.v1.part.getWorkGeometry({id: shelf, name: "WCSD"} );
wcsPrt2d = wcsPrt2d.result;

foc = @api.v1.assembly.fastenedOrigin({
  id: root,
  mate1: { matePath: [instances[0]], wcsId: wcs0Prt1 }
});
foc = foc.result;

fc = @api.v1.assembly.fastened({
  id: root,
  mate1: { matePath: [instances[0]], wcsId: wcs0Prt1 },
  mate2: { matePath: [shelfInstances[0]], wcsId: wcsPrt2 }
});
fc = fc.result;

fc1 = @api.v1.assembly.fastened({
  id: root,
  mate1: { matePath: [instances[1]], wcsId: wcs1Prt1 },
  mate2: { matePath: [shelfInstances[0]], wcsId: wcsPrt2l }
});
fc1 = fc1.result;

fc2 = @api.v1.assembly.fastened({
  id: root,
  mate1: { matePath: [instances[2]], wcsId: wcs0Prt1 },
  mate2: { matePath: [shelfInstances[0]], wcsId: wcsPrt2ld, reorientType: "180" }
});
fc2 = fc2.result;

fc3 = @api.v1.assembly.fastened({
  id: root,
  mate1: { matePath: [instances[3]], wcsId: wcs1Prt1 },
  mate2: { matePath: [shelfInstances[0]], wcsId: wcsPrt2d, reorientType: "180" }
});
fc3 = fc3.result;

RETURN;
